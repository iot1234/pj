# LOCAL DEVELOPMENT ONLY.
# Copy this file to .env only for a developer machine. Production must start
# from .env.production.example instead. Never commit or share the resulting
# .env file.
#
# APP_KEY is required in every mode. Docker development also requires distinct
# non-empty DB_PASSWORD and DB_ROOT_PASSWORD values. XAMPP/Laragon must use a
# dedicated runtime database user and leave DB_ROOT_PASSWORD blank.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Bangkok
APP_KEY=
FORCE_HTTPS=false
TRUSTED_PROXIES=
# Optional non-secret label for a notification worker instance. Leave blank
# to use the container hostname; Railway workers use RAILWAY_REPLICA_ID first.
WORKER_INSTANCE_ID=

APP_BIND=127.0.0.1
APP_PORT=8080
SESSION_NAME=dormitory_session
SESSION_LIFETIME_SECONDS=43200
BOOKING_HOLD_SECONDS=86400
# Single-use resident activation code lifetime: 15 minutes to 30 days.
RESIDENT_ACTIVATION_TTL_SECONDS=604800
# Scheduled billing job only. Keep the admin ID blank on web/worker; set it to
# an active admin account only on the isolated monthly-billing job.
MONTHLY_BILLING_ADMIN_ID=
MONTHLY_BILLING_TIMEOUT_SECONDS=900

# Local PHP/XAMPP/Laragon may use 127.0.0.1. Docker Compose overrides DB_HOST
# to the internal service name `db` and DB_PORT to 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_FORWARD_PORT=3307
DB_DATABASE=dormitory
DB_USERNAME=dormitory
DB_PASSWORD=
# Docker Compose database bootstrap only. Leave blank/remove on XAMPP/Laragon;
# the PHP web process must never receive the MySQL root password.
DB_ROOT_PASSWORD=
DB_SSL=false
DB_SSL_CA=

# One-time input for scripts/create_admin.php. Prefer a temporary shell/secret
# environment; if a manual install uses .env, remove the value immediately.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
ADMIN_ROLE=owner

# PromptPay, LINE Messaging and SlipOK/EasySlip settings are configured by an
# owner in Admin -> Settings and encrypted in MySQL. Do not add those tokens
# to this file. APP_KEY is the infrastructure key that protects them at rest.
