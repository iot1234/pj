# PRODUCTION TEMPLATE -- copy to .env, then replace every deployment-specific
# value before starting the system. Blank secrets are intentional and make
# Docker Compose/runtime fail closed instead of starting with a known secret.
# Never commit or share the resulting .env file.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://dormitory.example.com
APP_TIMEZONE=Asia/Bangkok
APP_KEY=
FORCE_HTTPS=true
# Comma-separated IP addresses of reverse proxies you control. Leave blank
# only when the PHP/Apache process receives HTTPS directly.
TRUSTED_PROXIES=

# Keep the container's plain-HTTP port bound to localhost behind a TLS reverse
# proxy. Secure session cookies are enabled when the resolved request is HTTPS.
APP_BIND=127.0.0.1
APP_PORT=8080
SESSION_NAME=dormitory_session
SESSION_LIFETIME_SECONDS=43200

# Docker Compose overrides DB_HOST to `db` and DB_PORT to 3306 for app/worker.
# For a non-Docker or remote MySQL deployment, replace host/port here.
DB_HOST=127.0.0.1
DB_PORT=3306
# Host-only maintenance port forwarded to the Docker MySQL container. This is
# not the port used by app/worker inside Compose.
DB_FORWARD_PORT=3307
DB_DATABASE=dormitory
DB_USERNAME=dormitory
DB_PASSWORD=
# Used only by the Docker MySQL bootstrap process. It is not passed to the
# long-running PHP app/worker. Leave blank/remove for XAMPP or Laragon.
DB_ROOT_PASSWORD=
# false is appropriate for the private Docker network. For remote MySQL, set
# true and provide a readable CA file after configuring server-side TLS.
DB_SSL=false
DB_SSL_CA=

# One-time input for scripts/create_admin.php. Prefer temporary process
# environment variables; keep ADMIN_PASSWORD blank in this file and remove it
# immediately if a manual bootstrap ever places it here.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=
ADMIN_ROLE=owner

# PromptPay, LINE Messaging and SlipOK/EasySlip credentials are configured by
# an owner in Admin -> Settings and encrypted in MySQL. Do not place them here.
